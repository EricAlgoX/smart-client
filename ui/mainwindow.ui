  <property name="styleSheet">
   <string notr="true">/*   🌆 1. 窗口背景设置 */
#SmartClient {
    background-image: url(&quot;resources/icons/background1.png&quot;);
    background-repeat: no-repeat; 
    background-position: center;
}

/* 🎨 2. 全局基础样式（所有控件） */
* {
    color: white;
	background: transparent;
}

/* 🖱 3. QPushButton样式 */
QPushButton {
	border-radius: 4px; 
    border: 1px solid rgba(255, 255, 255, 0.1);
	background-color: rgba(255, 255, 255, 0.1);
}
QPushButton:checked {
	border: 1px solid white;
    background-color: rgba(255, 255, 255, 0.5);
}
QPushButton:hover {
	border: 1px solid white;
    background-color: rgba(255, 255, 255, 0.3);
}
QPushButton:disabled {/* 不可用状态 */
    background-color: rgba(255, 255, 255, 0.05); /* 更暗的半透明 */
    color: rgba(255, 255, 255, 0.4);           /* 灰白文字 */
    border: 1px solid rgba(255,255,255,0.2);   /* 边框也更暗 */
}

/* 	   4.下拉框（与输入框保持一致风格） */
QComboBox {
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.7);
    color: white;
}

/* 🎛 5.QDoubleSpinBox 样式 */
QDoubleSpinBox {
    background-color: rgba(255, 255, 255, 0.1); /* 半透明背景 */                               
    border: 1px solid rgba(255, 255, 255, 0.5); /* 边框 */
    border-radius: 4px;                          /* 圆角 */
    padding: 2px 4px;                            /* 内边距 */
}

QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {/* 鼠标悬停效果 */
    background-color: rgba(255,255,255,0.4);
}

/* 🎚 6. QSlider 样式（白色圆点） */
QSlider::groove:horizontal {
    background: rgba(255,255,255,0.2);
    height: 4px;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: white;
    border: none;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    margin: -5px 0;
}
QSlider::sub-page:horizontal {/* 已滑动部分 */
    background: rgba(255,255,255,0.6);
    border-radius: 2px;
}
QSlider::add-page:horizontal {/* 未滑动部分 */
    background: rgba(255,255,255,0.1);
    border-radius: 2px;
}
QSlider::handle:horizontal:hover {/* hover 高亮 */
    background: #00bfff;
}

/* 📋 7. 表格 / 列表 / 树控件 */
QTableWidget, QTableView {/* 整个表格背景 */
    background-color: rgba(30, 30, 30, 0.2); /* 深色半透明背景 */
    color: white;                             /* 字体颜色 */
    border: none; /* 表格边框 */
    gridline-color: rgba(255,255,255,0.3);   /* 网格线颜色 */
    selection-background-color: rgba(0, 120, 215, 0.5); /* 选中行背景 */
    selection-color: white;                   /* 选中行文字 */
}
QHeaderView::section {/* 表头样式 */
    background-color: rgba(30, 30, 30, 0.2); /* 表头深色 */
    color: white;                             /* 表头字体 */
    border: 1px solid rgba(255,255,255,0.3); /* 表头边框 */
    padding: 4px;                             /* 内边距 */
    border-radius: 4px;                       /* 圆角 */
}
QTableCornerButton::section {/* 表格角落按钮（左上角） */
    background-color: rgba(30, 30, 30, 0.2);
    border: 1px solid rgba(255,255,255,0.3);
}
QScrollBar:vertical {
    background: transparent;
    border: none;
    width: 12px;
    margin: 4px 2px 4px 0px;   /* 上、右、下、左 */
}

QScrollBar:horizontal {
    background: transparent;
    border: none;
    height: 6px;
    margin: 0px 4px 2px 4px;   /* 上、右、下、左 */
}

QScrollBar::handle {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 3px;
}
QScrollBar::handle:hover {
    background: rgba(255, 255, 255, 0.6);
}
QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
    border: none;
	height: 0px;
    width: 0px;
}

/* 🪟 8. 弹出窗口样式（正常显示）*/
QDialog, QMessageBox {
    background-color: white;
    color: black;
    border: 1px solid #cccccc;
    border-radius: 8px;
    padding: 10px;
}
QDialog *,
QMessageBox * {/* 确保弹出窗口内的控件正常显示 */
    background-color: white;
    color: black;
    border: 1px solid #cccccc;
}


/* 9. 全局 tooltip 样式 */
QToolTip {
    background-color: rgba(50, 50, 50, 230);  /* 半透明深灰 */
    color: white;                              /* 字体白色 */
    border: 1px solid white;                   /* 白色边框 */
    border-radius: 4px;                        /* 圆角 */
    padding: 4px 8px;                          /* 内边距 */
    font-size: 12px;                           /* 字体大小 */
}</string>

/* ══════════════════════════════════════════════
   Smart-Client — Industrial Dark Theme v3
   ══════════════════════════════════════════════ */

/* ── 全局 ── */
* {
    color: #e2e8f0;
    font-family: "Microsoft YaHei", "Segoe UI", "PingFang SC", sans-serif;
    font-size: 12px;
}
QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #0a0a1a, stop:0.5 #12122a, stop:1 #0a0a1a);
}
QWidget { background: transparent; }
*:focus { outline: none; }
*:focus-visible { border: 2px solid #3b82f6; border-radius: 4px; }


/* ── 工具栏 ── */
QToolBar {
    background: rgba(15, 15, 30, 0.95);
    border-bottom: 1px solid rgba(59, 130, 246, 0.15);
    padding: 6px 10px;
    spacing: 4px;
}
QToolBar QToolButton {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 6px;
    padding: 6px 14px;
    color: #94a3b8;
    font-size: 12px;
    letter-spacing: 0.5px;
}
QToolBar QToolButton:hover {
    background: rgba(59, 130, 246, 0.12);
    border: 1px solid rgba(59, 130, 246, 0.35);
    color: #e2e8f0;
}
QToolBar QToolButton:pressed {
    background: rgba(59, 130, 246, 0.3);
    color: white;
}
QToolBar::separator { width: 1px; background: rgba(255, 255, 255, 0.06); margin: 4px 8px; }
#toolbarLabel { color: #64748b; background: transparent; border: none; font-size: 12px; }
#versionLabel { color: #334155; font-size: 11px; background: transparent; border: none; }


/* ── 场景选择器 ── */
#sceneBox {
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.3);
    border-radius: 6px;
    padding: 5px 12px;
    color: #93c5fd;
    font-weight: bold;
    font-size: 12px;
}
#sceneBox:hover { border: 1px solid rgba(59, 130, 246, 0.6); }
#sceneBox::drop-down {
    subcontrol-origin: padding; subcontrol-position: top right;
    width: 28px; border: none; border-left: 1px solid rgba(255, 255, 255, 0.06);
}
#sceneBox::down-arrow {
    border-left: 5px solid transparent; border-right: 5px solid transparent;
    border-top: 6px solid #64748b; margin-right: 10px;
}
#sceneBox QAbstractItemView {
    background: #1e1e2e; border: 1px solid #3a3a55; border-radius: 6px;
    selection-background-color: rgba(59, 130, 246, 0.3);
    color: #e2e8f0; padding: 4px; outline: none;
}


/* ── 状态栏 ── */
QStatusBar {
    background: rgba(10, 10, 26, 0.95);
    border-top: 1px solid rgba(59, 130, 246, 0.15);
    color: #94a3b8;
    font-size: 11px;
    padding: 2px 0;
}
#statusItem {
    color: #64748b; background: transparent;
    padding: 2px 14px;
    border-right: 1px solid rgba(255, 255, 255, 0.04);
    font-size: 11px;
}
#statusDotGreen {
    color: #22c55e; font-size: 16px; background: transparent;
    padding: 0 4px 0 12px; border: none;
}
#statusDotRed {
    color: #ef4444; font-size: 16px; background: transparent;
    padding: 0 4px 0 12px; border: none;
}


/* ── 视频区 ── */
#videoContainer {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(15, 15, 30, 0.9), stop:1 rgba(5, 5, 15, 0.95));
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 12px;
}
#videoLabel {
    background: transparent; border: none; color: #334155;
    font-size: 14px;
}

/* 格子样式 + hover 高亮 */
#gridCell {
    background: #0a0a1a;
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 8px;
}
#gridCell:hover {
    border: 1px solid rgba(59, 130, 246, 0.4);
    background: rgba(10, 10, 26, 0.8);
}

/* 空状态占位 */
#placeholderWidget { background: transparent; }
#placeholderIcon {
    font-size: 56px; background: transparent; border: none;
    color: #1e293b;
}
#placeholderTitle {
    color: #475569; font-size: 20px; font-weight: bold;
    background: transparent; border: none; letter-spacing: 2px;
}
#placeholderHint {
    color: #334155; font-size: 13px;
    background: transparent; border: none;
}
/* 骨架条 shimmer */
#skeletonBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0a0a1a, stop:0.2 #1e1e2e, stop:0.5 #2a2a3e,
        stop:0.8 #1e1e2e, stop:1 #0a0a1a);
    border-radius: 4px;
}


/* ── 分割器 ── */
QSplitter::handle { background: rgba(255, 255, 255, 0.02); }
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical { height: 2px; }
QSplitter::handle:hover { background: rgba(59, 130, 246, 0.4); }


/* ── GroupBox 面板 ── */
QGroupBox {
    background: rgba(20, 20, 40, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-top: 2px solid rgba(59, 130, 246, 0.4);
    border-radius: 10px;
    margin-top: 20px;
    padding: 14px 10px 10px 10px;
    font-size: 12px;
    font-weight: bold;
    color: #475569;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 3px 12px;
    color: #93c5fd;
    font-size: 12px;
    background: rgba(10, 10, 26, 0.9);
    border-radius: 4px;
}


/* ── 告警列表 ── */
#alertList {
    background: rgba(5, 5, 15, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.03);
    border-radius: 8px;
    font-size: 11px;
    outline: none;
}
#alertList::item {
    padding: 6px 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.02);
    color: #94a3b8;
    min-height: 20px;
}
#alertList::item:hover { background: rgba(59, 130, 246, 0.08); }
#alertList::item:selected { background: rgba(59, 130, 246, 0.2); color: #e2e8f0; }
#alertList QHeaderView::section {
    background: rgba(15, 15, 30, 0.8); color: #475569;
    border: none; border-bottom: 2px solid rgba(59, 130, 246, 0.3);
    padding: 6px 8px; font-size: 11px; font-weight: bold;
    letter-spacing: 1px;
}


/* ── 统计面板 ── */
#statsKey {
    color: #475569; font-size: 11px;
    background: transparent; border: none; padding: 8px 0;
    letter-spacing: 1px;
}
#statsValue {
    color: #60a5fa; font-size: 22px; font-weight: bold;
    background: transparent; border: none; padding: 4px 0;
}
#statsValueAlert {
    color: #ef4444; font-size: 22px; font-weight: bold;
    background: transparent; border: none; padding: 4px 0;
}


/* ── 记录表 ── */
#recordTitle {
    color: #94a3b8; font-size: 13px; font-weight: bold;
    background: transparent; border: none; letter-spacing: 1px;
}
#recordTable {
    background: rgba(5, 5, 15, 0.6);
    alternate-background-color: rgba(255, 255, 255, 0.015);
    color: #e2e8f0;
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 8px;
    gridline-color: rgba(255, 255, 255, 0.03);
    selection-background-color: rgba(59, 130, 246, 0.2);
    selection-color: #e2e8f0;
    font-size: 11px;
    outline: none;
}
#recordTable QHeaderView::section {
    background: rgba(15, 15, 30, 0.8); color: #475569;
    border: none; border-bottom: 2px solid rgba(59, 130, 246, 0.3);
    padding: 6px 8px; font-size: 11px; font-weight: bold;
    letter-spacing: 1px;
}
    border: none; border-bottom: 1px solid rgba(59, 130, 246, 0.2);
    padding: 5px 8px; font-size: 11px; font-weight: bold;
}


/* ── 按钮 ── */
QPushButton {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 6px;
    padding: 6px 14px;
    color: #94a3b8;
    font-size: 12px;
}
QPushButton:hover {
    background: rgba(59, 130, 246, 0.12);
    border: 1px solid rgba(59, 130, 246, 0.35);
    color: #e2e8f0;
}
QPushButton:pressed {
    background: rgba(59, 130, 246, 0.25);
    border: 1px solid rgba(59, 130, 246, 0.5);
    color: white;
}
QPushButton:checked {
    background: rgba(34, 197, 94, 0.15);
    border: 1px solid rgba(34, 197, 94, 0.4);
    color: #86efac;
}
QPushButton:disabled {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.03);
    color: #334155;
}
QPushButton:focus-visible {
    border: 2px solid rgba(59, 130, 246, 0.6);
}

/* 次要按钮 */
#secondaryBtn {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.04);
    font-size: 11px; color: #64748b;
}
#secondaryBtn:hover {
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.3);
    color: #94a3b8;
}


/* ── 输入控件 ── */
QComboBox {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 6px; padding: 5px 10px; color: #e2e8f0;
}
QComboBox:hover { border: 1px solid rgba(59, 130, 246, 0.35); }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 24px; border: none; }
QComboBox::down-arrow { border-left: 5px solid transparent; border-right: 5px solid transparent; border-top: 6px solid #64748b; margin-right: 8px; }
QComboBox QAbstractItemView {
    background: #1e1e2e; border: 1px solid #3a3a55; border-radius: 6px;
    selection-background-color: rgba(59, 130, 246, 0.25); color: #e2e8f0; padding: 4px; outline: none;
}

QDoubleSpinBox, QSpinBox {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 6px; padding: 5px 8px; color: #e2e8f0;
}
QDoubleSpinBox:hover, QSpinBox:hover { border: 1px solid rgba(59, 130, 246, 0.35); }
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button,
QSpinBox::up-button, QSpinBox::down-button { background: transparent; border: none; width: 18px; }
QDoubleSpinBox::up-arrow { border-left: 4px solid transparent; border-right: 4px solid transparent; border-bottom: 5px solid #64748b; }
QDoubleSpinBox::down-arrow { border-left: 4px solid transparent; border-right: 4px solid transparent; border-top: 5px solid #64748b; }
QSpinBox::up-arrow { border-left: 4px solid transparent; border-right: 4px solid transparent; border-bottom: 5px solid #64748b; }
QSpinBox::down-arrow { border-left: 4px solid transparent; border-right: 4px solid transparent; border-top: 5px solid #64748b; }


/* ── QLabel ── */
QLabel { color: #94a3b8; background: transparent; font-size: 12px; }


/* ── 日志 ── */
QTextEdit {
    background: rgba(5, 5, 15, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 8px;
    color: #64748b;
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 11px; padding: 10px;
    selection-background-color: rgba(59, 130, 246, 0.3);
}


/* ── 滚动条 ── */
QScrollBar:vertical { background: transparent; width: 6px; margin: 4px 2px 4px 0; }
QScrollBar:horizontal { background: transparent; height: 6px; margin: 0 4px 2px 4px; }
QScrollBar::handle { background: rgba(255, 255, 255, 0.08); border-radius: 3px; min-height: 30px; }
QScrollBar::handle:hover { background: rgba(255, 255, 255, 0.15); }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page { background: transparent; border: none; height: 0; width: 0; }


/* ── 弹窗 ── */
QDialog, QMessageBox {
    background: #1e1e2e; color: #e2e8f0;
    border: 1px solid #3a3a55; border-radius: 12px; padding: 20px;
}
QDialog *, QMessageBox * { background: transparent; color: #e2e8f0; border: none; }
QDialog QPushButton, QMessageBox QPushButton {
    background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px; padding: 8px 28px; min-width: 80px; font-size: 12px;
}
QDialog QPushButton:hover, QMessageBox QPushButton:hover {
    background: rgba(59, 130, 246, 0.2); border: 1px solid rgba(59, 130, 246, 0.5); color: white;
}
#settingsDialog { background: #1e1e2e; }


/* ── 流标签栏 ── */
#streamAddBtn {
    background: rgba(59, 130, 246, 0.15);
    border: 1px solid rgba(59, 130, 246, 0.3);
    border-radius: 6px;
    color: #93c5fd;
    font-size: 14px;
    font-weight: bold;
}
#streamAddBtn:hover {
    background: rgba(59, 130, 246, 0.3);
    border: 1px solid rgba(59, 130, 246, 0.6);
    color: white;
}

#streamTab {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 4px;
    padding: 2px 10px;
    color: #64748b;
    font-size: 11px;
}
#streamTab:hover {
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.25);
    color: #94a3b8;
}
#streamTab:checked {
    background: rgba(59, 130, 246, 0.2);
    border: 1px solid rgba(59, 130, 246, 0.5);
    color: #93c5fd;
}

#streamTabClose {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #475569;
    font-size: 10px;
}
#streamTabClose:hover {
    background: rgba(239, 68, 68, 0.2);
    color: #fca5a5;
}


/* ── Tooltip ── */
QToolTip {
    background: #1e1e2e; color: #e2e8f0;
    border: 1px solid #3a3a55; border-radius: 8px;
    padding: 8px 12px; font-size: 11px;
}

/* ── InputDialog ── */
QInputDialog QLabel { color: #e2e8f0; background: transparent; }
QInputDialog QLineEdit, QInputDialog QComboBox {
    background: rgba(255, 255, 255, 0.06); border: 1px solid #3a3a55;
    border-radius: 6px; padding: 6px 12px; color: #e2e8f0;
}

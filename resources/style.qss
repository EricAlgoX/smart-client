/* ══════════════════════════════════════════════
   Smart-Client — Industrial Dark Theme
   ══════════════════════════════════════════════ */

/* ── 全局 ── */
* {
    color: #e2e8f0;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 12px;
}
QMainWindow { background: #1a1a2e; }
QWidget { background: transparent; }

/* ── 工具栏 ── */
QToolBar {
    background: #1e1e2e;
    border-bottom: 1px solid #2a2a3e;
    padding: 4px 8px;
    spacing: 4px;
}
QToolBar QToolButton {
    background: #252536;
    border: 1px solid #2a2a3e;
    border-radius: 4px;
    padding: 5px 12px;
    color: #94a3b8;
    font-size: 12px;
}
QToolBar QToolButton:hover {
    background: #2d2d42;
    border: 1px solid #3b82f6;
    color: #e2e8f0;
}
QToolBar QToolButton:pressed { background: #3b82f6; color: white; }
QToolBar::separator { width: 1px; background: #2a2a3e; margin: 4px 6px; }
#toolbarLabel { color: #64748b; font-size: 12px; background: transparent; border: none; }
#versionLabel { color: #3a3a55; font-size: 11px; background: transparent; border: none; }

/* ── 场景下拉框 ── */
#sceneBox {
    background: #252536;
    border: 1px solid #3b82f6;
    border-radius: 5px;
    padding: 4px 10px;
    color: #e2e8f0;
    font-size: 12px;
    font-weight: bold;
}
#sceneBox:hover { border: 1px solid #60a5fa; }
#sceneBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border: none;
    border-left: 1px solid #2a2a3e;
}
#sceneBox::down-arrow {
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #94a3b8;
    margin-right: 8px;
}
#sceneBox QAbstractItemView {
    background: #252536;
    border: 1px solid #3a3a55;
    selection-background-color: #3b82f6;
    color: #e2e8f0;
    padding: 4px;
}

/* ── 状态栏 ── */
QStatusBar {
    background: #1a1a2e;
    border-top: 1px solid #2a2a3e;
    color: #94a3b8;
    font-size: 11px;
    padding: 2px 0;
}
#statusItem {
    color: #94a3b8;
    background: transparent;
    padding: 2px 10px;
    border-right: 1px solid #2a2a3e;
    font-size: 11px;
}
#statusDotGreen { color: #22c55e; font-size: 14px; background: transparent; padding: 0 4px 0 10px; border: none; }
#statusDotRed { color: #ef4444; font-size: 14px; background: transparent; padding: 0 4px 0 10px; border: none; }

/* ── 视频区 ── */
#videoContainer {
    background: #0f0f1a;
    border: 1px solid #2a2a3e;
    border-radius: 8px;
}
#videoLabel { background: transparent; border: none; color: #4a4a65; font-size: 14px; }
#placeholderWidget { background: transparent; }
#placeholderTitle { color: #4a4a65; font-size: 18px; font-weight: bold; background: transparent; border: none; }
#placeholderHint { color: #3a3a55; font-size: 12px; background: transparent; border: none; }

/* ── QSplitter ── */
QSplitter::handle { background: #2a2a3e; }
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical { height: 2px; }
QSplitter::handle:hover { background: #3b82f6; }

/* ── GroupBox ── */
QGroupBox {
    background: #1e1e2e;
    border: 1px solid #2a2a3e;
    border-radius: 8px;
    margin-top: 18px;
    padding: 12px 8px 8px 8px;
    font-size: 12px;
    font-weight: bold;
    color: #64748b;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 10px;
    color: #60a5fa;
    font-size: 12px;
    background: #1a1a2e;
    border-radius: 3px;
}

/* ── 告警列表 ── */
#alertList {
    background: #0f0f1a;
    border: 1px solid #2a2a3e;
    border-radius: 6px;
    font-size: 11px;
    outline: none;
}
#alertList::item {
    padding: 4px 6px;
    border-bottom: 1px solid #1a1a2e;
}
#alertList::item:selected { background: #1d4ed8; }
QHeaderView::section {
    background: #1e1e2e;
    color: #64748b;
    border: none;
    border-bottom: 1px solid #3b82f6;
    padding: 4px 6px;
    font-size: 11px;
    font-weight: bold;
}

/* ── 统计面板 ── */
#statsKey { color: #64748b; font-size: 11px; background: transparent; border: none; }
#statsValue { color: #60a5fa; font-size: 16px; font-weight: bold; background: transparent; border: none; }

/* ── 检测记录表 ── */
#recordTitle { color: #94a3b8; font-size: 12px; font-weight: bold; background: transparent; border: none; }
#recordTable {
    background: #0f0f1a;
    alternate-background-color: #141428;
    color: #e2e8f0;
    border: 1px solid #2a2a3e;
    border-radius: 6px;
    gridline-color: #1a1a2e;
    selection-background-color: #1d4ed8;
    font-size: 11px;
    outline: none;
}
#recordTable QHeaderView::section {
    background: #1e1e2e;
    color: #64748b;
    border: none;
    border-bottom: 1px solid #3b82f6;
    padding: 4px 6px;
    font-size: 11px;
}

/* ── 按钮 ── */
QPushButton {
    background: #252536;
    border: 1px solid #2a2a3e;
    border-radius: 5px;
    padding: 5px 12px;
    color: #94a3b8;
    font-size: 12px;
}
QPushButton:hover { background: #2d2d42; border: 1px solid #3b82f6; color: #e2e8f0; }
QPushButton:pressed { background: #3b82f6; color: white; }
QPushButton:checked { background: #1d4ed8; border: 1px solid #3b82f6; color: white; }
#secondaryBtn { background: #1e1e2e; border: 1px solid #2a2a3e; font-size: 11px; }
#secondaryBtn:hover { background: #252536; border: 1px solid #3b82f6; }

/* ── 设置弹窗 ── */
#settingsDialog { background: #252536; }
QDialog, QMessageBox {
    background: #252536;
    color: #e2e8f0;
    border: 1px solid #3a3a55;
    border-radius: 10px;
    padding: 16px;
}
QDialog *, QMessageBox * { background: transparent; color: #e2e8f0; border: none; }
QDialog QPushButton, QMessageBox QPushButton {
    background: #2d2d42;
    border: 1px solid #3a3a55;
    border-radius: 6px;
    padding: 6px 24px;
    min-width: 70px;
}
QDialog QPushButton:hover, QMessageBox QPushButton:hover { background: #3b82f6; border: 1px solid #3b82f6; color: white; }

/* ── 输入控件 ── */
QComboBox {
    background: #252536;
    border: 1px solid #2a2a3e;
    border-radius: 5px;
    padding: 4px 10px;
    color: #e2e8f0;
}
QComboBox:hover { border: 1px solid #3b82f6; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 24px; border: none; }
QComboBox::down-arrow { border-left: 5px solid transparent; border-right: 5px solid transparent; border-top: 6px solid #94a3b8; margin-right: 8px; }
QComboBox QAbstractItemView { background: #252536; border: 1px solid #3a3a55; selection-background-color: #3b82f6; color: #e2e8f0; padding: 4px; }

QDoubleSpinBox, QSpinBox {
    background: #252536;
    border: 1px solid #2a2a3e;
    border-radius: 5px;
    padding: 4px 8px;
    color: #e2e8f0;
}
QDoubleSpinBox:hover, QSpinBox:hover { border: 1px solid #3b82f6; }
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button,
QSpinBox::up-button, QSpinBox::down-button { background: transparent; border: none; width: 18px; }
QDoubleSpinBox::up-arrow { border-left: 4px solid transparent; border-right: 4px solid transparent; border-bottom: 5px solid #94a3b8; }
QDoubleSpinBox::down-arrow { border-left: 4px solid transparent; border-right: 4px solid transparent; border-top: 5px solid #94a3b8; }
QSpinBox::up-arrow { border-left: 4px solid transparent; border-right: 4px solid transparent; border-bottom: 5px solid #94a3b8; }
QSpinBox::down-arrow { border-left: 4px solid transparent; border-right: 4px solid transparent; border-top: 5px solid #94a3b8; }

/* ── QLabel ── */
QLabel { color: #94a3b8; background: transparent; font-size: 12px; }

/* ── 日志 ── */
QTextEdit {
    background: #0f0f1a;
    border: 1px solid #2a2a3e;
    border-radius: 6px;
    color: #94a3b8;
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 11px;
    padding: 8px;
}

/* ── 滚动条 ── */
QScrollBar:vertical { background: transparent; width: 8px; margin: 4px 2px 4px 0; }
QScrollBar:horizontal { background: transparent; height: 8px; margin: 0 4px 2px 4px; }
QScrollBar::handle { background: #2a2a3e; border-radius: 4px; min-height: 30px; }
QScrollBar::handle:hover { background: #3a3a55; }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent; border: none; height: 0; width: 0;
}

/* ── Tooltip ── */
QToolTip { background: #252536; color: #e2e8f0; border: 1px solid #3a3a55; border-radius: 6px; padding: 6px 10px; font-size: 11px; }

/* ── QInputDialog ── */
QInputDialog QLabel { color: #e2e8f0; background: transparent; }
QInputDialog QLineEdit, QInputDialog QComboBox {
    background: #252536; border: 1px solid #3a3a55; border-radius: 5px; padding: 5px 10px; color: #e2e8f0;
}
